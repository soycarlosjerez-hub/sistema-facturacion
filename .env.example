# ============================================================================
# Erpipos ERP — Configuration Environment File (EXAMPLE)
# ============================================================================
# Copia este archivo a .env y ajusta las variables según tu entorno:
#   cp .env.example .env
# ============================================================================

# ─── Aplicación ────────────────────────────────────────────────────────────

APP_NAME="Erpipos ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de Datos ────────────────────────────────────────────────────────

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erpipos
DB_USERNAME=root
DB_PASSWORD=your-strong-password

# ─── Caches ────────────────────────────────────────────────────────────────

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ─── Redis ────────────────────────────────────────────────────────────────

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Sessions ──────────────────────────────────────────────────────────────

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue / Jobs ──────────────────────────────────────────────────────────

QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=90
QUEUE_MAX_ATTEMPTS=3

# ─── Email / Mail ─────────────────────────────────────────────────────────

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@empresa.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 (Backups/Storage) ─────────────────────────────────────────────

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── DGII — Facturación Electrónica ────────────────────────────────────────

DGII_AMBIENTE=sandbox
DGII_API_URL_SANDBOX=https://sandbox.dgii.gov.do
DGII_API_URL_QA=https://qa.dgii.gov.do
DGII_API_URL_PROD=https://api.dgii.gov.do
DGII_CERT_STORAGE_PATH=storage/dgii/certs
DGII_XML_STORAGE_PATH=storage/dgii/xml
DGII_CERT_PASSWORD=
DGII_CONSULTA_URL=https://dgii.gov.do/consultas
DGII_SIMULAR=true
DGII_PROB_APROB=0.95
DGII_QR_ENDPOINT=https://dgii.gov.do/qr

ITBIS_DEFAULT=18
MONEDA_DEFAULT=RD$

# ─── Autenticación ─────────────────────────────────────────────────────────

# Clave JWT para API tokens (generar con php artisan jwt:secret si usas tymon)
# JWT_SECRET=

# ─── Two-Factor Authentication (2FA) ──────────────────────────────────────

# Clave de cifrado generada automáticamente con php artisan key:generate
# No compartas esta clave
# TWO_FACTOR_ENABLED=true
# TWO_FACTOR_LIFETIME=30  # minutos

# ─── Rate Limiting ─────────────────────────────────────────────────────────

RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_BACKUP=3

# ─── Backups ──────────────────────────────────────────────────────────────

BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30
BACKUP_AUTO_SCHEDULE=0
BACKUP_COMPRESS=true

# ─── Telescope (Monitoreo) ─────────────────────────────────────────────────

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
TELESCOPE_DOMAIN=
TELESCOPE_HTTP_MIDDLEWARE=
TELESCOPE_STORAGE_DRIVER=database
TELESCOPE_IMAGE_DRIVER=local

# ─── Suscripciones SaaS ────────────────────────────────────────────────────

SUSCRIPCION_TRIAL_DAYS=15
SUSCRIPCION_GRACE_DAYS=3
SUSCRIPCION_PLAN_DEFAULT=basic
SUSCRIPCION_CURRENCY=RD$

# ─── SMTP / Email Providers (Opcional) ────────────────────────────────────

# Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Postmark
POSTMARK_TOKEN=

# SendGrid
SENDGRID_API_KEY=

# ─── OpenAI / IA ──────────────────────────────────────────────────────────

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ─── Google Maps ──────────────────────────────────────────────────────────

GOOGLE_MAPS_API_KEY=

# ─── Impresoras / ECF ────────────────────────────────────────────────────

ECF_IP_DEFAULT=192.168.1.100
ECF_PORT_DEFAULT=9100
ECF_TIMEOUT=5

# ─── Seguridad ────────────────────────────────────────────────────────────

SESSION_SECURE_COOKIE=true
CSRF_COOKIE_DOMAIN=
API_STRICT=true

# ─── Storage ───────────────────────────────────────────────────────────────

FILESYSTEM_DISK=local
# FILESYSTEM_CLOUD=s3

# ─── Pay/Ticket ────────────────────────────────────────────────────────────

PAYMENT_PROCESSOR=stripe
STRIPE_KEY=
STRIPE_SECRET=

# ─── Multi-Tenancy / Hostnames ────────────────────────────────────────────

MULTITENANCY_ENABLED=true
HOSTNAME_TENANCY=false

# ─── Debug / Development ───────────────────────────────────────────────────

# GENERATE_KEY_COMMAND="php artisan key:generate"
# MIGRATE_REFRESH="php artisan migrate:fresh --seed"
